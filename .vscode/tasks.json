{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Rat",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/rat.ps1",
                "-Action",
                "Build"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Flash via DFU (CubeProgrammer)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/rat.ps1",
                "-Action",
                "Flash"
            ],
            "problemMatcher": []
        },
        {
            "label": "List DFU devices",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/rat.ps1",
                "-Action",
                "List"
            ],
            "problemMatcher": []
        }
    ]
}
